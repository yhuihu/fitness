<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="健身计划制定器"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <!-- 计划设置区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="计划名称:">

            </TextView>
            <EditText
                android:id="@+id/et_plan_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="输入计划名称"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="循环时长(分钟):">

            </TextView>
            <EditText
                android:id="@+id/et_cycle_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="例如: 30"
                android:inputType="number"/>

        </LinearLayout>

        <Button
            android:id="@+id/btn_add_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="添加训练项"/>

    </LinearLayout>

    <!-- 计划项列表 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/ll_items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 计划项会动态添加到这里 -->

        </LinearLayout>

    </ScrollView>

    <!-- 当前计划显示 -->
    <TextView
        android:id="@+id/tv_current_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="当前计划: 无"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>

    <!-- 休息倒计时 -->
    <TextView
        android:id="@+id/tv_rest_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="休息倒计时: 0s"
        android:textSize="18sp"
        android:textColor="@android:color/holo_blue"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_rest_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="开始休息"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btn_rest_skip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="跳过休息"/>

    </LinearLayout>

</LinearGraph>

<LinearLayout xmlns:android="http://schemas/android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:text="健身计划项设置"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
 prsy="组数:""
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="组数: ">

        </TextView>
        <EditText
            android:id="@+id/et_sets"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="例如: 3"
            android:inputType="number"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="组间休息(秒): ">

        </TextView>
        <EditText
            android:id="@+id/et_rest_between"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="例如: 60"
            android:inputType="number"/>

    </LinearLayout>

    <Button
        android:id="@+id/btn_save_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
nattenhe="保存"/>

    </LinearLayout>
</LinearGraph>

</LinearLayout>
</LinearLayout>
</LinearGraph>