.page {
    min-height: 100vh;
    background: #f6f7fb;
    padding: 24rpx 24rpx 60rpx;
    box-sizing: border-box;
}

/* 顶部渐变卡片 */
.hero {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 24rpx;
    padding: 40rpx 32rpx;
    color: #ffffff;
    box-shadow: 0 12rpx 30rpx rgba(102, 126, 234, 0.28);
}

.hero-title {
    font-size: 40rpx;
    font-weight: 700;
    line-height: 1.3;
    word-break: break-all;
}

.hero-sub {
    margin-top: 12rpx;
    font-size: 24rpx;
    opacity: 0.85;
}

/* 区块标题 */
.block-title {
    margin: 36rpx 8rpx 16rpx;
    font-size: 30rpx;
    font-weight: 600;
    color: #323233;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.block-hint {
    font-size: 24rpx;
    font-weight: 400;
    color: #969799;
}

/* 白卡片 */
.card {
    background: #ffffff;
    border-radius: 20rpx;
    padding: 8rpx 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.form-item {
    padding: 20rpx 0;
}

.form-label {
    font-size: 26rpx;
    color: #646566;
    margin-bottom: 8rpx;
}

.divider {
    height: 1rpx;
    background: #f2f3f5;
}

.add-btn {
    margin-top: 24rpx;
    border-radius: 16rpx !important;
    height: 88rpx !important;
    font-size: 30rpx !important;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
    border: none !important;
}

/* 训练项卡片 */
.item-card {
    background: #ffffff;
    border-radius: 20rpx;
    padding: 28rpx 24rpx 16rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.item-head {
    display: flex;
    align-items: center;
}

.item-index {
    width: 44rpx;
    height: 44rpx;
    line-height: 44rpx;
    text-align: center;
    border-radius: 50%;
    background: rgba(102, 126, 234, 0.12);
    color: #667eea;
    font-size: 24rpx;
    font-weight: 600;
    margin-right: 16rpx;
    flex-shrink: 0;
}

.item-name {
    font-size: 32rpx;
    font-weight: 600;
    color: #323233;
    flex: 1;
    word-break: break-all;
}

.item-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin: 18rpx 0 12rpx 60rpx;
}

.item-actions {
    display: flex;
    justify-content: flex-end;
    border-top: 1rpx solid #f2f3f5;
    margin: 0 -24rpx;
    padding: 0 12rpx;
}

.item-action {
    padding: 18rpx 28rpx;
    font-size: 26rpx;
    color: #667eea;
}

.item-action.danger {
    color: #ee0a24;
}

/* 弹窗 */
.modal {
    padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.modal-title {
    text-align: center;
    font-size: 34rpx;
    font-weight: 600;
    color: #323233;
    margin-bottom: 16rpx;
}

.modal-form {
    background: #f7f8fa;
    border-radius: 16rpx;
    padding: 8rpx 24rpx;
    margin-bottom: 28rpx;
}

.modal-actions {
    display: flex;
    gap: 20rpx;
}

.modal-actions .van-button {
    flex: 1;
}

/* 空状态 */
.empty-card {
    padding: 56rpx 24rpx;
    text-align: center;
}

.empty-emoji {
    font-size: 64rpx;
    margin-bottom: 16rpx;
}

.empty-text {
    font-size: 26rpx;
    color: #969799;
}