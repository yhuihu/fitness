.page {
    min-height: 100vh;
    background: #f6f7fb;
    padding: 24rpx 24rpx 60rpx;
    box-sizing: border-box;
}

.hero {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 24rpx;
    padding: 40rpx 32rpx;
    color: #ffffff;
    box-shadow: 0 12rpx 30rpx rgba(102, 126, 234, 0.28);
}

.hero-title {
    font-size: 40rpx;
    font-weight: 700;
}

.hero-sub {
    margin-top: 12rpx;
    font-size: 24rpx;
    opacity: 0.85;
}

.block-title {
    margin: 36rpx 8rpx 16rpx;
    font-size: 30rpx;
    font-weight: 600;
    color: #323233;
}

.card {
    background: #ffffff;
    border-radius: 20rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.clear-wrap {
    margin-top: 36rpx;
}

.clear-btn {
    height: 88rpx !important;
    border-radius: 16rpx !important;
    font-size: 30rpx !important;
    color: #ee0a24 !important;
    border: 2rpx solid #ee0a24 !important;
    background: #ffffff !important;
}

.tips {
    margin-top: 32rpx;
    padding: 24rpx 28rpx;
    background: rgba(102, 126, 234, 0.06);
    border-radius: 16rpx;
}

.tips-title {
    font-size: 26rpx;
    font-weight: 600;
    color: #667eea;
    margin-bottom: 10rpx;
}

.tips-item {
    font-size: 24rpx;
    color: #646566;
    line-height: 1.8;
}